# Ignore Git metadata
.git/
.gitignore

# Ignore local dependency directories recursively
**/node_modules/

# Ignore compiled/build outputs recursively
**/dist/

# Ignore local environment files (server secrets must never be sent to Cloud Build)
server/.env
.env.local
# NOTE: client/.env.production is intentionally NOT ignored here
# so Vite can bake Firebase config into the frontend build.

# Ignore docker files
.dockerignore
.gcloudignore
